// Brute force approach -> Time Complexity = O(n^2)

class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int n = nums.length;
        int count = 0;

        for(int i=0; i<n; i++){
            int sum = 0;
            for(int j=i; j<n; j++){
                sum += nums[j];
                if(sum%k == 0){
                    count++;
                }
            }
        }
        return count;
    }
}


// Optimal approach -> Time Complexity = O(n)

class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int n = nums.length;
        HashMap<Integer, Integer> map = new HashMap<>();
        map.put(0,1);
        int count = 0;
        int sum = 0;

        for(int i=0; i<n; i++){
            sum += nums[i];
            int rem = sum % k;

            if(rem < 0){
                rem += k;
            }

            if(map.containsKey(rem)){
                count += map.get(rem);
            }
            map.put(rem, map.getOrDefault(rem, 0)+1);
        }
        return count;
    }
}

