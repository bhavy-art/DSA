class Solution {
    public int findPages(int[] arr, int k) {

        int n = arr.length;

        if (k > n) {
            return -1;
        }

        int low = 0;
        long high = 0;

        for (int pages : arr) {
            low = Math.max(low, pages);
            high += pages;
        }

        long ans = high;

        while (low <= high) {
            long mid = low + (high - low) / 2;

            if (canAllocate(arr, k, mid)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return (int) ans;
    }

    private boolean canAllocate(int[] arr, int k, long maxPages) {

        int students = 1;
        long pagesSum = 0;

        for (int pages : arr) {

            if (pagesSum + pages <= maxPages) {
                pagesSum += pages;
            } else {
                students++;
                pagesSum = pages;

                if (students > k) {
                    return false;
                }
            }
        }

        return true;
    }
}