Optimal Solution => Time Complexity = O(log n)

// Leetcode
class Solution {
    public int findMin(int[] nums) {
      int left = 0;
      int right = nums.length-1;

      while(left < right){
        int mid = left + (right - left)/2;

        if(nums[mid] > nums[right]){
            left = mid + 1;
        }else{
            right = mid; 
        }
      }
      return nums[left];
    }
}


// GOG

class Solution {
    public int findMin(int[] arr) {
        // code here
        int left = 0;
        int right = arr.length-1;
        
        while(left < right){
            int mid = left + (right - left)/2;
            if(arr[mid] > arr[right]){
                left = mid + 1;
            }else{
                right = mid;
            }
        }
        return arr[left];
    }
}
