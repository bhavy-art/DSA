Optimal Solution => Time Complexity = O(log n)
 
// Leet code
class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int low = 0;
        int high = n-1;

        while(low<=high){
            int mid = low + (high - low)/2;
             if(nums[mid] == target){
                return mid;
             }

             if(nums[low] <= nums[mid]){
                if(nums[low] <= target && target <= nums[mid]){
                    high = mid - 1;
                }else{
                    low = mid + 1;
                }
             }else{
                if(nums[mid] <= target && target <= nums[high]){
                    low = mid + 1;
                }else{
                    high = mid - 1;
                }
             }
        }
         return -1;
    }
}


// GOG

class Solution {
    int search(int[] arr, int key) {
        // code here
        int left = 0;
        int right = arr.length-1;
        
        while(left <= right){
            int mid = left + (right - left)/2;
            
            if(arr[mid] == key){
                return mid;
            }
            
            if(arr[left] <= arr[mid]){
                if(arr[left] <= key && key <= arr[mid]){
                    right = mid - 1;
                }else{
                    left = mid + 1;
                }
            }else{
                if(arr[mid] <= key && key <= arr[right]){
                    left = mid + 1;
                }else{
                    right = mid - 1;
                }   
            }
        }
        return -1;
    }
}