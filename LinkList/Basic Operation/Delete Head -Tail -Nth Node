// Leetcode

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        // find size
        int size = 0;
        ListNode temp = head;
        while(temp!=null){
            temp = temp.next;
            size++;
        }

        // if delete head node
        if(n==size){
            return head.next;
          
        }

        // size-n
        int i = 1;
        int idxToFind = size-n;
        ListNode prev = head;
        while(i<idxToFind){
            prev = prev.next;
            i++;
        }

        // delete node
        prev.next = prev.next.next;
        return head;
        
    }
}



// gfg
class Solution {
    Node deleteNode(Node head, int x) {

        // If head itself needs to be deleted
        if (x == 1) {
            return head.next;
        }

        Node temp = head;

        // Move to the node just before position x
        for (int i = 1; i < x - 1; i++) {
            temp = temp.next;
        }

        // Delete the node
        temp.next = temp.next.next;

        return head;
    }
}