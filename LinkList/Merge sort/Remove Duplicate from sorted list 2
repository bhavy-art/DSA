class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        ListNode dummy = new ListNode(0);
        dummy.next = head;

        ListNode prev = dummy;

        while (head != null) {
            // if duplicate found
            if (head.next != null && head.val == head.next.val) {
                int dup = head.val;
                // skip all nodes with this value
                while (head != null && head.val == dup) {
                    head = head.next;
                }
                prev.next = head;
            } else {
                prev = prev.next;
                head = head.next;
            }
        }
        return dummy.next; 
    }
}