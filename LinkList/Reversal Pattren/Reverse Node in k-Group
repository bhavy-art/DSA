// leetcode

class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
        ListNode temp = head;
        int count = 0;

        // step 1
        while(count < k){
            if(temp == null){
                return head;
            }
            temp = temp.next;
            count++;
        }
        // step 2
        ListNode prevNode = reverseKGroup(temp, k);
        // step 3
        temp = head;
        count = 0;
        while(count < k){
           
            ListNode next = temp.next;
            temp.next = prevNode;
            prevNode = temp;
            temp = next;

            count++;
        }

        return prevNode;
    }
}