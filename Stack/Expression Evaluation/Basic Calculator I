// Leetcode
class Solution {
    public int calculate(String s) {

        Stack<Integer> stack = new Stack<>();

        int result = 0;
        int num = 0;
        int sign = 1;

        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            if (Character.isDigit(ch)) {
                num = num * 10 + (ch - '0');
            }

            else if (ch == '+') {
                result += sign * num;
                num = 0;
                sign = 1;
            }

            else if (ch == '-') {
                result += sign * num;
                num = 0;
                sign = -1;
            }

            else if (ch == '(') {

                stack.push(result);
                stack.push(sign);

                result = 0;
                sign = 1;
                num = 0;
            }

            else if (ch == ')') {

                result += sign * num;

                int prevSign = stack.pop();
                int prevResult = stack.pop();

                result = prevResult + prevSign * result;

                num = 0;
            }
        }

        result += sign * num;

        return result;
    }
}



