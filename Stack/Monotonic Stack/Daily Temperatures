// Brute force approach => Time Complexity = O(n^2)
// LeetCode
class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        int n = temperatures.length;
        int ans[] = new int[n];
        Arrays.fill(ans,0);

        for(int i=0; i<n-1; i++){
            for(int j=i+1; j<n; j++){
                if(temperatures[i] < temperatures[j]){
                    ans[i] = j-i;
                    break;
                }
            }
        }
        return ans;
    }
}


// Optimal Solution = Time Complexity = O(n)
// LeetCode
class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        int n = temperatures.length;
        int ans[] = new int[n];
        Stack<Integer> stack = new Stack<>();

        for(int i=n-1; i>=0; i--){
            int num = temperatures[i];

            while(!stack.isEmpty() && temperatures[stack.peek()] <= num){
                stack.pop();
            }
            if(!stack.isEmpty()){
                ans[i] = stack.peek() - i;
            }
            stack.push(i);
        }
        return ans;
    }
}