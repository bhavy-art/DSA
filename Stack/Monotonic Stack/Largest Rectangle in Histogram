// leetcode
class Solution {
    public int largestRectangleArea(int[] arr) {
        int n = arr.length;
        int right[] = new int[n];
        int left[] = new int[n];
        int ans = 0;
        Stack<Integer> stack = new Stack<>();
        
        // right
        for(int i=n-1; i>=0; i--){
            while(!stack.isEmpty() && arr[stack.peek()] >= arr[i]){
                stack.pop();
            }
            if(!stack.isEmpty()){
                right[i] = stack.peek();
            }else{
                right[i] = n;
            }
            stack.push(i);
        }

        stack.clear();
        for(int i=0; i<n; i++){
            while(!stack.isEmpty() && arr[stack.peek()] >= arr[i]){
                stack.pop();
            }
            if(!stack.isEmpty()){
                left[i] = stack.peek();
            }else{
                left[i] = -1;
            }
            stack.push(i);
        }

        for(int i=0; i<n; i++){
            int height = arr[i];
            int width = right[i] - left[i] - 1;
            int currWater = height * width;
            ans = Math.max(ans, currWater);
        }
        return ans;
    }
}



