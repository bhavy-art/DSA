// Brute force approach 
// ḷeetcode
class Solution {
    public int maximalRectangle(char[][] matrix) {
        int rows = matrix.length;
        int cols = matrix[0].length;
        int ans = 0;

        for(int r1=0; r1<rows; r1++){
            for(int c1=0; c1<cols; c1++){
                if(matrix[r1][c1] == '0'){
                    continue;
                }
                for(int r2=r1; r2<rows; r2++){
                    for(int c2=c1; c2<cols; c2++){
                        if(isAllOne(matrix, r1, c1, r2, c2)){
                            int currArea = (r2-r1+1) * (c2-c1+1);
                            ans = Math.max(ans, currArea);
                        }
                    }
                }
            }
        }
        return ans;
    }
        private boolean isAllOne(char[][] matrix, int r1, int c1, int r2, int c2){
            for(int i=r1; i<=r2; i++){
                for(int j=c1; j<=c2; j++){
                    if(matrix[i][j] == '0'){
                        return false;
                    }
                }
            }
            return true;
        }
}


// Optimal approach
// Leetcode
class Solution {

    public int maximalRectangle(char[][] matrix) {

        if (matrix.length == 0) {
            return 0;
        }

        int rows = matrix.length;
        int cols = matrix[0].length;

        int[] heights = new int[cols];
        int ans = 0;

        for (int r = 0; r < rows; r++) {

            // Build histogram
            for (int c = 0; c < cols; c++) {

                if (matrix[r][c] == '1') {
                    heights[c]++;
                } else {
                    heights[c] = 0;
                }
            }

            ans = Math.max(ans, largestRectangleArea(heights));
        }

        return ans;
    }

    private int largestRectangleArea(int[] arr) {

        int n = arr.length;

        int[] left = new int[n];
        int[] right = new int[n];

        Stack<Integer> stack = new Stack<>();

        // Nearest smaller on right
        for (int i = n - 1; i >= 0; i--) {

            while (!stack.isEmpty() && arr[stack.peek()] >= arr[i]) {
                stack.pop();
            }

            if (stack.isEmpty()) {
                right[i] = n;
            } else {
                right[i] = stack.peek();
            }

            stack.push(i);
        }

        stack.clear();

        // Nearest smaller on left
        for (int i = 0; i < n; i++) {

            while (!stack.isEmpty() && arr[stack.peek()] >= arr[i]) {
                stack.pop();
            }

            if (stack.isEmpty()) {
                left[i] = -1;
            } else {
                left[i] = stack.peek();
            }

            stack.push(i);
        }

        int maxArea = 0;

        for (int i = 0; i < n; i++) {

            int height = arr[i];
            int width = right[i] - left[i] - 1;

            maxArea = Math.max(maxArea, height * width);
        }

        return maxArea;
    }
}



