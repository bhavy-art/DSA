// leetcode optimal solution in time complexity we can reduce the space complexity
class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> stack = new Stack<>();
        stack.push(0);

        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            if(ch == '('){
                stack.push(0);
            }
            else{
                int val = stack.pop();
                int score = Math.max(2*val, 1);
                stack.push(score + stack.pop());
            }
        }
        return stack.pop();
    }
}


// leetcode optimal solution with less space complexity
class Solution {
    public int scoreOfParentheses(String s) {
        int count = 0;
        int score = 0;

        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            if(ch == '('){
                count++;
            }else{
                count--;
                if(s.charAt(i-1) == '('){
                    score += 1 << count;
                }
            }
        }
        return score;
    }
}