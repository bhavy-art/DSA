class Solution {
    public void deleteMid(Stack<Integer> s) {
        int mid = s.size() / 2 + 1;
        delete(s, mid);
    }

    private void delete(Stack<Integer> s, int k) {
        if (k == 1) {
            s.pop();
            return;
        }

        int top = s.pop();

        delete(s, k - 1);

        s.push(top);
    }
}