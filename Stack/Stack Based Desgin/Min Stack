// Optimal but less effiiecent in space complexity
import java.util.*;

class MinStack {

    Stack<Integer> stack;
    Stack<Integer> minStack;

    public MinStack() {
        stack = new Stack<>();
        minStack = new Stack<>();
    }

    public void push(int val) {
        stack.push(val);

        if (minStack.isEmpty() || val <= minStack.peek()) {
            minStack.push(val);
        }
    }

    public void pop() {
        int val = stack.pop();

        if (val == minStack.peek()) {
            minStack.pop();
        }
    }

    public int top() {
        return stack.peek();
    }

    public int getMin() {
        return minStack.peek();
    }
}
// Leetcode optimal approach more effiecent in space complexity
import java.util.*;

class MinStack {
    Stack<Long> stack;
    long min;

    public MinStack() {
        stack = new Stack<>();
    }

    public void push(int val) {
        if (stack.isEmpty()) {
            stack.push(0L);
            min = val;
        } else {
            long diff = (long) val - min;
            stack.push(diff);

            if (diff < 0) {
                min = val;
            }
        }
    }

    public void pop() {
        long top = stack.pop();

        if (top < 0) {
            min = min - top;
        }
    }

    public int top() {
        long top = stack.peek();

        if (top >= 0) {
            return (int)(top + min);
        }

        return (int)min;
    }

    public int getMin() {
        return (int)min;
    }
}


