Brute force approach => Time complexity = O(n^2)

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> res = new ArrayList<>();

        int n = s.length();
        int m = p.length();

        int pCount[] = new int[26];
        for(char c:p.toCharArray()){
            pCount[c-'a']++;
        }
        for(int i=0;i<=n-m;i++){
            int sCount[] = new int[26];

        for(int j=i;j<=i+m-1;j++){
            sCount[s.charAt(j)-'a']++;
        }
        if(Arrays.equals(pCount,sCount)){
            res.add(i);
        }
    }
      return res;
    }
}

Optimal approach => Time complexity = O(n)

class Solution {
    public List<Integer> findAnagrams(String s, String p) {

        List<Integer> ans = new ArrayList<>();

        int n = s.length();
        int m = p.length();

        if (m > n)
            return ans;

        int[] pCount = new int[26];
        int[] window = new int[26];

        // Frequency of pattern
        for (char ch : p.toCharArray()) {
            pCount[ch - 'a']++;
        }

        // Build first window
        for (int i = 0; i < m; i++) {
            window[s.charAt(i) - 'a']++;
        }

        // Check first window
        if (Arrays.equals(pCount, window)) {
            ans.add(0);
        }

        // Slide the window
        for (int i = m; i < n; i++) {

            // Add new character
            window[s.charAt(i) - 'a']++;

            // Remove old character
            window[s.charAt(i - m) - 'a']--;

            if (Arrays.equals(pCount, window)) {
                ans.add(i - m + 1);
            }
        }

        return ans;
    }
}