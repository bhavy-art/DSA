Brute force approach => Time Complexity = O((n - m + 1) × m)

class Solution {
    public boolean checkInclusion(String s1, String s2) {

        int n = s2.length();
        int m = s1.length();

        if (m > n)
            return false;

        int[] s1Count = new int[26];

        for (char ch : s1.toCharArray())
            s1Count[ch - 'a']++;

        for (int i = 0; i <= n - m; i++) {

            int[] window = new int[26];

            for (int j = i; j < i + m; j++) {
                window[s2.charAt(j) - 'a']++;
            }

            if (Arrays.equals(window, s1Count))
                return true;
        }

        return false;
    }
}

Optimal approach => Time Complexity = (n)

class Solution {
    public boolean isFreqSame(int freq1[], int freq2[]){
        for(int i=0;i<26;i++){
            if(freq1[i]!=freq2[i]){
                return false;
            }
        }
        return true;
    }
    public boolean checkInclusion(String s1, String s2) {
        if(s1.length() > s2.length()){
            return false;
        }
        int freq1[] = new int[26];
        int freq2[] = new int[26];

        for(int i=0;i<s1.length();i++){
            freq1[s1.charAt(i)-'a']++;
        }

        int windSize = s1.length();
        for(int i=0;i<windSize;i++){
           freq2[s2.charAt(i)-'a']++;
        }
        if(isFreqSame(freq1,freq2)){
                return true;
            }

        for(int i=windSize;i<s2.length();i++){
             freq2[s2.charAt(i)-'a']++;
              freq2[s2.charAt(i-windSize)-'a']--;

               if(isFreqSame(freq1,freq2)){
                return true;
            }
        }
            return false;
    }
}