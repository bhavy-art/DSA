class Solution {
    public boolean isPalindrome(String s) {
        int n = s.length();
        int left = 0;
        int right = n-1;

        while(left<right){
            char l = s.charAt(left);
            char r = s.charAt(right);

            if(!isAlphaNumeric(l)){
                left++;
            }else if(!alphaNumeric(r)){
                right--;
            }else{
                if(Character.toLowerCase(l) != char.toLowerCase(r)){
                    return false;
                }
                left++;
                right--;
            }
        }
        return true;
    }

    private boolean isAlphaNumeric(char c){
         return (c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9');
    }
}